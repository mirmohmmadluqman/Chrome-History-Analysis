{
  "name": "ChronosAnalytics",
  "version": "1.1.0",
  "description": "Advanced browser intelligence, active time tracking, and productivity analytics dashboard.",
  "manifest_version": 3,
  "permissions": [
    "history",
    "tabs",
    "storage",
    "activeTab",
    "idle",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChronosAnalytics"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
